# Domain produksi (dipakai Caddyfile HTTPS & CORS)
APP_DOMAIN=harga.gitafarma.example.com

# Server
APP_ENV=development
HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Storage
STORAGE_DRIVER=sqlite
STORAGE_PATH=./data/gitafarma.db

# Google Sheets Integration (Workload Identity Federation / ADC)
# Di VPS/Docker dengan OIDC token: arahkan ke file external_account hasil `gcloud iam workload-identity-pools create-cred-config`
# Di lokal dengan `gcloud auth application-default login`: kosongkan GOOGLE_APPLICATION_CREDENTIALS
GOOGLE_APPLICATION_CREDENTIALS=./credentials/wif-config.json
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=
GSHEET_SPREADSHEET_ID=your-spreadsheet-id
GSHEET_MEDICINES_SHEET=medicines
GSHEET_ADMINS_SHEET=admins
SYNC_INTERVAL=5m

# Admin Auth (Google SSO)
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
SESSION_SECRET=change-me-to-a-long-random-32-byte-secret
SESSION_TTL=8h
SESSION_COOKIE_SECURE=false
ADMIN_WHITELIST_CACHE_TTL=6h

# Web Push (VAPID) — generate dengan: make vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@gitafarma.local

# Web (Vite) — kosongkan saat memakai proxy Nginx/Vite agar same-origin
VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
